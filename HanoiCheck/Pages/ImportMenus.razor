@page "/import-menus"
@layout MainLayout
@implements IDisposable
@inject IFilePickerService FilePicker
@inject IMenuApiService MenuApi
@inject MenuExcelImportService ExcelImport
@inject MenuResolverService Resolver
@inject IMenuSaveService SaveService
@inject IDemoLicenseService DemoLicense

<section class="import-page menu-import-page">
    <div class="import-content">
        <div class="page-title-row">
            <div>
                <p class="eyebrow accent">IMPORT DỮ LIỆU</p>
                <h1>Import thực đơn</h1>
                <p>Nhập và đồng bộ thực đơn từ file Excel theo từng khối thực đơn.</p>
            </div>
            @if (_isLoadingOptions)
            {
                <span class="loading-note"><span class="spinner dark"></span> Đang tải dữ liệu chọn...</span>
            }
            else
            {
                <button class="text-button" type="button" disabled="@_isBusy" @onclick="RefreshOptionsAsync">
                    Làm mới dữ liệu chọn
                </button>
            }
        </div>

        @if (!string.IsNullOrWhiteSpace(_pageError))
        {
            <div class="alert" role="alert">@_pageError</div>
        }

        <div class="source-grid excel-only">
            <div class="source-card">
                <div class="source-number">1</div>
                <div class="source-body">
                    <strong>File Excel thực đơn</strong>
                    <span title="@_excelPath">@FileDisplay(_excelPath, "Chưa chọn file .xlsx")</span>
                </div>
                <button class="outline-button" type="button" disabled="@_isBusy" @onclick="PickExcel">
                    Chọn file
                </button>
            </div>
            <button class="read-button" type="button"
                    disabled="@(_isBusy || string.IsNullOrWhiteSpace(_excelPath) || _isLoadingOptions)"
                    @onclick="ReadDataAsync">
                @if (_isBusy && !_isSaving)
                {
                    <span class="spinner"></span>
                    <span>Đang xử lý...</span>
                }
                else
                {
                    <span>Đọc dữ liệu</span>
                }
            </button>
        </div>

        @if (_result is not null)
        {
            <div class="summary-grid menu-summary-grid">
                <button class="summary-card total @FilterClass(RowFilter.All)" @onclick="() => SetFilter(RowFilter.All)">
                    <span>Tổng thực đơn</span><strong>@_result.Total</strong>
                </button>
                <button class="summary-card valid @FilterClass(RowFilter.Valid)" @onclick="() => SetFilter(RowFilter.Valid)">
                    <span>Hợp lệ</span><strong>@_result.Valid</strong>
                </button>
                <button class="summary-card pending @FilterClass(RowFilter.RequiresSelection)" @onclick="() => SetFilter(RowFilter.RequiresSelection)">
                    <span>Cần xác nhận</span><strong>@_result.RequiresSelection</strong>
                </button>
                <button class="summary-card error @FilterClass(RowFilter.Error)" @onclick="() => SetFilter(RowFilter.Error)">
                    <span>Lỗi</span><strong>@_result.Errors</strong>
                </button>
                <button class="summary-card saved @FilterClass(RowFilter.Saved)" @onclick="() => SetFilter(RowFilter.Saved)">
                    <span>Đã lưu</span><strong>@_result.Saved</strong>
                </button>
            </div>

            <div class="save-readiness">
                <div>
                    <strong>@ReadyRows.Count thực đơn sẵn sàng lưu</strong>
                    <span>Thực đơn cần xác nhận hoặc có lỗi sẽ không được gửi.</span>
                </div>
                <button class="save-button" type="button"
                        disabled="@(_isBusy || ReadyRows.Count == 0)"
                        @onclick="OpenBulkConfirm">
                    Lưu @ReadyRows.Count thực đơn hợp lệ
                </button>
            </div>

            @if (_isSaving && _saveProgress is not null)
            {
                <div class="save-progress-panel">
                    <div class="save-progress-heading">
                        <div>
                            <strong>Đang lưu @_saveProgress.Current / @_saveProgress.Total</strong>
                            <span>@Display(_saveProgress.CurrentRow.Name) - @Display(_saveProgress.CurrentRow.Code)</span>
                        </div>
                        <strong>@SaveProgressPercentage%</strong>
                    </div>
                    <div class="progress-track"><div style="width: @SaveProgressPercentage%"></div></div>
                    <button class="cancel-save-button" type="button" @onclick="CancelSave">Hủy</button>
                </div>
            }

            <div class="preview-panel">
                <div class="preview-toolbar">
                    <div>
                        <h2>Preview theo thực đơn</h2>
                        <span>@FilteredRows.Count() thực đơn đang hiển thị</span>
                    </div>
                    <div class="filter-tabs">
                        <button class="@FilterButtonClass(RowFilter.All)" @onclick="() => SetFilter(RowFilter.All)">Tất cả</button>
                        <button class="@FilterButtonClass(RowFilter.Valid)" @onclick="() => SetFilter(RowFilter.Valid)">Hợp lệ</button>
                        <button class="@FilterButtonClass(RowFilter.RequiresSelection)" @onclick="() => SetFilter(RowFilter.RequiresSelection)">Cần xác nhận</button>
                        <button class="@FilterButtonClass(RowFilter.Error)" @onclick="() => SetFilter(RowFilter.Error)">Lỗi</button>
                        <button class="@FilterButtonClass(RowFilter.Saved)" @onclick="() => SetFilter(RowFilter.Saved)">Đã lưu</button>
                        <button class="@FilterButtonClass(RowFilter.SaveFailed)" @onclick="() => SetFilter(RowFilter.SaveFailed)">Lưu lỗi</button>
                    </div>
                </div>

                <div class="table-scroll">
                    <table class="preview-table menu-preview-table">
                        <thead>
                            <tr>
                                <th>Dòng bắt đầu</th>
                                <th>Mã thực đơn</th>
                                <th>Tên thực đơn</th>
                                <th>Trạng thái</th>
                                <th>Nhóm tuổi</th>
                                <th>Thứ áp dụng</th>
                                <th>Số trường</th>
                                <th>Số món</th>
                                <th>Resolve</th>
                                <th>Lưu hệ thống</th>
                                <th>Thao tác</th>
                            </tr>
                        </thead>
                        <tbody>
                            @foreach (var row in FilteredRows)
                            {
                                <tr>
                                    <td class="row-number">@row.RowNumber</td>
                                    <td><strong>@Display(row.Code)</strong></td>
                                    <td><strong>@Display(row.Name)</strong></td>
                                    <td>@StatusValue(row)</td>
                                    <td>@Display(row.StudentGroupName, row.Source.StudentGroupValue)</td>
                                    <td>@Display(row.DayName, row.Source.DayValue)</td>
                                    <td><strong>@row.SchoolIds.Count</strong><small>/ @row.Source.SchoolValues.Count khai báo</small></td>
                                    <td><strong>@row.Items.Count</strong></td>
                                    <td>
                                        <span class="status-badge @ValidationStatusClass(row.ValidationStatus)">
                                            @ValidationStatusText(row.ValidationStatus)
                                        </span>
                                        @if (row.Errors.Count > 0)
                                        {
                                            <small class="row-message" title="@string.Join("; ", row.Errors)">@row.Errors[0]</small>
                                        }
                                        else if (row.Warnings.Count > 0)
                                        {
                                            <small class="row-message warning">@row.Warnings[0]</small>
                                        }
                                    </td>
                                    <td>
                                        <span class="save-status-badge @SaveStatusClass(row.SaveStatus)">
                                            @if (row.SaveStatus == BatchSaveStatus.Saving)
                                            {
                                                <span class="mini-spinner"></span>
                                            }
                                            @SaveStatusText(row.SaveStatus)
                                        </span>
                                        @if (!string.IsNullOrWhiteSpace(row.SaveMessage))
                                        {
                                            <small class="row-message" title="@row.SaveMessage">@row.SaveMessage</small>
                                        }
                                    </td>
                                    <td>
                                        <div class="action-stack">
                                            @if (row.ResolutionIssues.Count > 0)
                                            {
                                                <button class="resolve-button" disabled="@_isBusy" @onclick="() => ShowResolution(row)">Xác nhận</button>
                                            }
                                            <button class="icon-action" @onclick="() => ShowDetail(row)">Xem chi tiết</button>
                                            @if (row.ValidationStatus == ImportRowStatus.Valid && row.SaveStatus == BatchSaveStatus.NotStarted)
                                            {
                                                <button class="row-save-button" disabled="@_isBusy" @onclick="() => OpenSingleConfirm(row)">Lưu dòng này</button>
                                            }
                                            else if (row.ValidationStatus == ImportRowStatus.Valid && row.SaveStatus == BatchSaveStatus.Failed && CanRetry(row))
                                            {
                                                <button class="row-retry-button" disabled="@_isBusy" @onclick="() => OpenSingleConfirm(row)">Thử lại</button>
                                            }
                                        </div>
                                    </td>
                                </tr>
                            }
                        </tbody>
                    </table>
                    @if (!FilteredRows.Any())
                    {
                        <div class="empty-state">Không có thực đơn nào trong bộ lọc này.</div>
                    }
                </div>
            </div>

            @if (FailedRows.Count > 0 && !_isSaving)
            {
                <div class="retry-bar">
                    <div><strong>@FailedRows.Count thực đơn lưu thất bại</strong><span>Có thể thử lại các lỗi chắc chắn chưa tạo dữ liệu.</span></div>
                    <button class="outline-button" @onclick="OpenRetryConfirm">Thử lại dòng lỗi</button>
                </div>
            }

            @if (UnknownRows.Count > 0)
            {
                <div class="unknown-warning">
                    @UnknownRows.Count thực đơn chưa xác định kết quả. Hãy kiểm tra trên hệ thống trước khi gửi lại để tránh tạo trùng.
                </div>
            }
        }
        else
        {
            <div class="welcome-panel">
                <div class="welcome-icon">XLSX</div>
                <h2>Chưa có dữ liệu preview</h2>
                <p>Mỗi khối bắt đầu bằng một Mã thực đơn và chứa nhiều dòng Bữa + Món ăn bên dưới.</p>
            </div>
        }
    </div>
</section>

@if (_activeIssue is not null)
{
    <div class="modal-backdrop">
        <div class="modal-card">
            <div class="modal-header">
                <div>
                    <p class="eyebrow accent">CẦN XÁC NHẬN</p>
                    <h2>Chọn @_activeIssue.DisplayName</h2>
                    <p>Giá trị Excel: <strong>@_activeIssue.SourceValue</strong></p>
                </div>
                <button class="modal-close" @onclick="CloseModal">×</button>
            </div>
            <div class="candidate-list">
                @foreach (var candidate in _activeIssue.Candidates)
                {
                    <button class="candidate-card" disabled="@_isBusy" @onclick="() => SelectCandidateAsync(candidate)">
                        <strong>@Display(candidate.Name)</strong>
                        @if (!string.IsNullOrWhiteSpace(candidate.Code))
                        {
                            <span>Mã: @candidate.Code</span>
                        }
                        @if (!string.IsNullOrWhiteSpace(candidate.Metadata))
                        {
                            <span>@candidate.Metadata</span>
                        }
                    </button>
                }
            </div>
            <p class="modal-hint">Lựa chọn được nhớ trong phiên import hiện tại. Món ăn được nhớ riêng theo từng nhóm tuổi.</p>
        </div>
    </div>
}

@if (_detailRow is not null)
{
    <div class="modal-backdrop">
        <div class="modal-card menu-detail-modal">
            <div class="modal-header">
                <div>
                    <p class="eyebrow accent">CHI TIẾT THỰC ĐƠN</p>
                    <h2>@Display(_detailRow.Name)</h2>
                    <p>Mã: @Display(_detailRow.Code) · @_detailRow.Items.Count món</p>
                </div>
                <button class="modal-close" @onclick="CloseModal">×</button>
            </div>
            <div class="meal-groups">
                @foreach (var group in DetailGroups)
                {
                    <section class="meal-group">
                        <h3>@group.Key</h3>
                        @foreach (var item in group)
                        {
                            <div class="dish-detail-row">
                                <div>
                                    <strong>@Display(item.DishName, item.SourceDishValue)</strong>
                                    <small>Dòng Excel @item.SourceRowNumber</small>
                                </div>
                                <span>@(string.IsNullOrWhiteSpace(item.DishCode) ? "Chưa có mã" : $"Mã: {item.DishCode}")</span>
                            </div>
                        }
                    </section>
                }
            </div>
        </div>
    </div>
}

@if (_confirmRequest is not null)
{
    <div class="modal-backdrop">
        <div class="modal-card confirm-modal">
            <div class="modal-header">
                <div><p class="eyebrow accent">XÁC NHẬN LƯU</p><h2>@ConfirmTitle</h2></div>
                <button class="modal-close" @onclick="CloseModal">×</button>
            </div>
            <div class="confirm-message">
                <p>@ConfirmMessage</p>
                @if (_confirmRequest == SaveRequestKind.Bulk && _result is not null)
                {
                    <p>@_result.Errors thực đơn lỗi và @_result.RequiresSelection thực đơn cần xác nhận sẽ không được lưu.</p>
                }
            </div>
            <div class="modal-actions">
                <button class="outline-button" @onclick="CloseModal">Hủy</button>
                <button class="save-button" @onclick="ExecuteConfirmedSaveAsync">Tiếp tục</button>
            </div>
        </div>
    </div>
}

@if (_saveSummary is not null && !_isSaving)
{
    <div class="modal-backdrop">
        <div class="modal-card result-modal">
            <div class="modal-header">
                <div>
                    <p class="eyebrow accent">KẾT QUẢ</p>
                    <h2>@(_saveSummary.WasCancelled ? "Đã dừng lưu thực đơn" : "Hoàn tất lưu thực đơn")</h2>
                    <p>@_saveSummary.Message</p>
                </div>
                <button class="modal-close" @onclick="CloseSaveSummary">×</button>
            </div>
            <div class="result-summary-grid">
                <div><span>Tổng xử lý</span><strong>@_saveSummary.Processed</strong></div>
                <div class="success"><span>Thành công</span><strong>@_saveSummary.SuccessCount</strong></div>
                <div class="failed"><span>Thất bại</span><strong>@_saveSummary.FailedCount</strong></div>
                <div class="unknown"><span>Chưa xác định</span><strong>@_saveSummary.UnknownCount</strong></div>
            </div>
            <div class="modal-actions">
                @if (FailedRows.Count > 0)
                {
                    <button class="outline-button" @onclick="ShowSaveFailures">Xem dòng lỗi</button>
                    <button class="save-button" @onclick="OpenRetryFromSummary">Thử lại dòng lỗi</button>
                }
                else
                {
                    <button class="save-button" @onclick="CloseSaveSummary">Đóng</button>
                }
            </div>
        </div>
    </div>
}

@code {
    private readonly CancellationTokenSource _lifetimeCts = new();
    private string? _excelPath;
    private string? _pageError;
    private bool _isLoadingOptions;
    private bool _isBusy;
    private bool _isSaving;
    private RowFilter _filter = RowFilter.All;
    private IReadOnlyList<MenuImportBlock> _rawBlocks = [];
    private MenuValidationResult? _result;
    private MenuResolutionIssue? _activeIssue;
    private ResolvedMenuRow? _detailRow;
    private SaveRequestKind? _confirmRequest;
    private ResolvedMenuRow? _confirmRow;
    private MenuSaveProgress? _saveProgress;
    private MenuSaveSummary? _saveSummary;
    private CancellationTokenSource? _saveCts;

    private List<ResolvedMenuRow> ReadyRows => _result?.Rows.Where(row =>
        row.ValidationStatus == ImportRowStatus.Valid && row.SaveStatus == BatchSaveStatus.NotStarted).ToList() ?? [];
    private List<ResolvedMenuRow> FailedRows => _result?.Rows.Where(row =>
        row.ValidationStatus == ImportRowStatus.Valid && row.SaveStatus == BatchSaveStatus.Failed && CanRetry(row)).ToList() ?? [];
    private List<ResolvedMenuRow> UnknownRows => _result?.Rows.Where(row => row.SaveStatus == BatchSaveStatus.Unknown).ToList() ?? [];
    private int SaveProgressPercentage => _saveProgress is null || _saveProgress.Total == 0
        ? 0 : (int)Math.Round(_saveProgress.Current * 100d / _saveProgress.Total);
    private IEnumerable<ResolvedMenuRow> FilteredRows => _result?.Rows.Where(row => _filter switch
    {
        RowFilter.Valid => row.ValidationStatus == ImportRowStatus.Valid,
        RowFilter.RequiresSelection => row.ValidationStatus == ImportRowStatus.RequiresUserSelection,
        RowFilter.Error => row.ValidationStatus is ImportRowStatus.NotFound or ImportRowStatus.Error,
        RowFilter.Saved => row.SaveStatus == BatchSaveStatus.Success,
        RowFilter.SaveFailed => row.SaveStatus == BatchSaveStatus.Failed,
        _ => true
    }) ?? [];
    private IEnumerable<IGrouping<string, ResolvedMenuItem>> DetailGroups => _detailRow?.Items
        .GroupBy(item => Display(item.MealName, item.SourceMealValue)) ?? [];

    protected override async Task OnInitializedAsync() => await LoadOptionsAsync(false);

    private void PickExcel()
    {
        var path = FilePicker.PickExcelFile();
        if (!string.IsNullOrWhiteSpace(path))
        {
            _excelPath = path;
            _result = null;
            _pageError = null;
        }
    }

    private async Task LoadOptionsAsync(bool forceRefresh)
    {
        _isLoadingOptions = true;
        _pageError = null;
        try
        {
            if (!await EnsureLicenseAsync()) return;
            if (forceRefresh) MenuApi.ClearCache();
            var groupsTask = MenuApi.GetStudentGroupsAsync(false, _lifetimeCts.Token);
            var schoolsTask = MenuApi.GetSchoolOptionsAsync(false, _lifetimeCts.Token);
            await Task.WhenAll(groupsTask, schoolsTask);
            var groups = await groupsTask;
            var schools = await schoolsTask;
            if (!groups.IsSuccess) _pageError = groups.ErrorMessage;
            else if (!schools.IsSuccess) _pageError = schools.ErrorMessage;
        }
        catch (OperationCanceledException) when (_lifetimeCts.IsCancellationRequested) { }
        finally { _isLoadingOptions = false; }
    }

    private Task RefreshOptionsAsync() => LoadOptionsAsync(true);

    private async Task ReadDataAsync()
    {
        if (string.IsNullOrWhiteSpace(_excelPath)) return;
        _isBusy = true;
        _pageError = null;
        _result = null;
        Resolver.ResetSessionMappings();
        try
        {
            if (!await EnsureLicenseAsync()) return;
            var excel = await ExcelImport.ReadAsync(_excelPath, _lifetimeCts.Token);
            if (!excel.IsSuccess)
            {
                _pageError = excel.ErrorMessage;
                return;
            }

            _rawBlocks = excel.Rows;
            var resolved = await Resolver.ResolveAsync(_rawBlocks, _lifetimeCts.Token);
            if (resolved.IsSuccess) _result = resolved.Value;
            else _pageError = resolved.ErrorMessage;
        }
        catch (OperationCanceledException) when (_lifetimeCts.IsCancellationRequested) { }
        finally { _isBusy = false; }
    }

    private void ShowResolution(ResolvedMenuRow row)
    {
        _detailRow = null;
        _activeIssue = row.ResolutionIssues.FirstOrDefault();
    }

    private async Task SelectCandidateAsync(MenuOptionCandidate candidate)
    {
        if (_activeIssue is null || !await EnsureLicenseAsync()) return;
        Resolver.RememberSelection(_activeIssue, candidate.Id);
        _activeIssue = null;
        _isBusy = true;
        try
        {
            var previous = _result;
            var resolved = await Resolver.ResolveAsync(_rawBlocks, _lifetimeCts.Token);
            if (resolved.IsSuccess && resolved.Value is not null)
            {
                PreserveSaveStates(previous, resolved.Value);
                _result = resolved.Value;
            }
            else _pageError = resolved.ErrorMessage;
        }
        finally { _isBusy = false; }
    }

    private void ShowDetail(ResolvedMenuRow row)
    {
        _activeIssue = null;
        _detailRow = row;
    }

    private void CloseModal()
    {
        _activeIssue = null;
        _detailRow = null;
        _confirmRequest = null;
        _confirmRow = null;
    }

    private void OpenBulkConfirm()
    {
        if (ReadyRows.Count == 0) return;
        CloseModal();
        _confirmRequest = SaveRequestKind.Bulk;
    }

    private void OpenRetryConfirm()
    {
        if (FailedRows.Count == 0) return;
        CloseModal();
        _confirmRequest = SaveRequestKind.RetryFailed;
    }

    private void OpenSingleConfirm(ResolvedMenuRow row)
    {
        if (row.ValidationStatus != ImportRowStatus.Valid ||
            row.SaveStatus is BatchSaveStatus.Success or BatchSaveStatus.Unknown or BatchSaveStatus.Saving) return;
        CloseModal();
        _confirmRow = row;
        _confirmRequest = SaveRequestKind.Single;
    }

    private string ConfirmTitle => _confirmRequest switch
    {
        SaveRequestKind.Bulk => $"Lưu {ReadyRows.Count} thực đơn?",
        SaveRequestKind.RetryFailed => $"Thử lại {FailedRows.Count} thực đơn lỗi?",
        _ => "Lưu thực đơn này?"
    };

    private string ConfirmMessage => _confirmRequest switch
    {
        SaveRequestKind.Bulk => $"Bạn sắp lưu {ReadyRows.Count} thực đơn lên hệ thống.",
        SaveRequestKind.RetryFailed => "Chỉ các thực đơn lưu thất bại chắc chắn sẽ được gửi lại.",
        _ => "Thực đơn hợp lệ này sẽ được gửi lên hệ thống."
    };

    private async Task ExecuteConfirmedSaveAsync()
    {
        IReadOnlyCollection<ResolvedMenuRow> rows = _confirmRequest switch
        {
            SaveRequestKind.Bulk => ReadyRows,
            SaveRequestKind.RetryFailed => FailedRows,
            SaveRequestKind.Single when _confirmRow is not null => [_confirmRow],
            _ => Array.Empty<ResolvedMenuRow>()
        };
        CloseModal();
        if (rows.Count == 0) return;

        _saveSummary = null;
        _saveProgress = null;
        _isSaving = true;
        _isBusy = true;
        _saveCts?.Dispose();
        _saveCts = CancellationTokenSource.CreateLinkedTokenSource(_lifetimeCts.Token);
        var progress = new Progress<MenuSaveProgress>(value =>
        {
            _saveProgress = value;
            _ = InvokeAsync(StateHasChanged);
        });
        try
        {
            _saveSummary = await SaveService.SaveSequentiallyAsync(rows, progress, _saveCts.Token);
        }
        finally
        {
            _isSaving = false;
            _isBusy = false;
            _saveCts.Dispose();
            _saveCts = null;
        }
    }

    private void CancelSave() => _saveCts?.Cancel();
    private void ShowSaveFailures() { _filter = RowFilter.SaveFailed; CloseSaveSummary(); }
    private void OpenRetryFromSummary() { _saveSummary = null; OpenRetryConfirm(); }
    private void CloseSaveSummary() => _saveSummary = null;
    private void SetFilter(RowFilter filter) => _filter = filter;

    private async Task<bool> EnsureLicenseAsync()
    {
        var status = await DemoLicense.CheckAsync(false, _lifetimeCts.Token);
        if (status.CanUseApplication) return true;
        _pageError = status.ErrorMessage ?? "Phiên bản dùng thử đã hết hạn.";
        return false;
    }

    private static void PreserveSaveStates(MenuValidationResult? previous, MenuValidationResult updated)
    {
        if (previous is null) return;
        var oldRows = previous.Rows.ToDictionary(row => (row.Source.SourceFileName, row.RowNumber, row.Code));
        foreach (var row in updated.Rows)
        {
            if (!oldRows.TryGetValue((row.Source.SourceFileName, row.RowNumber, row.Code), out var old)) continue;
            row.SaveStatus = old.SaveStatus;
            row.LastSaveOutcome = old.LastSaveOutcome;
            row.SaveMessage = old.SaveMessage;
            row.SavedAt = old.SavedAt;
            row.MenuId = old.MenuId;
        }
    }

    private string FilterClass(RowFilter filter) => _filter == filter ? "selected" : string.Empty;
    private string FilterButtonClass(RowFilter filter) => _filter == filter ? "active" : string.Empty;
    private static string FileDisplay(string? path, string fallback) =>
        string.IsNullOrWhiteSpace(path) ? fallback : Path.GetFileName(path);
    private static string Display(params string?[] values) =>
        values.FirstOrDefault(value => !string.IsNullOrWhiteSpace(value)) ?? "—";
    private static string StatusValue(ResolvedMenuRow row) => row.Status switch
    {
        true => "Đang áp dụng",
        false => "Ngừng áp dụng",
        _ => Display(row.Source.StatusText)
    };
    private static string ValidationStatusClass(ImportRowStatus status) => status switch
    {
        ImportRowStatus.Valid => "status-valid",
        ImportRowStatus.RequiresUserSelection => "status-pending",
        _ => "status-error"
    };
    private static string ValidationStatusText(ImportRowStatus status) => status switch
    {
        ImportRowStatus.Valid => "Hợp lệ",
        ImportRowStatus.RequiresUserSelection => "Cần xác nhận",
        _ => "Lỗi"
    };
    private static string SaveStatusClass(BatchSaveStatus status) => status switch
    {
        BatchSaveStatus.Success => "save-success",
        BatchSaveStatus.Failed => "save-failed",
        BatchSaveStatus.Unknown => "save-unknown",
        BatchSaveStatus.Saving => "save-saving",
        _ => "save-not-started"
    };
    private static string SaveStatusText(BatchSaveStatus status) => status switch
    {
        BatchSaveStatus.Success => "Đã lưu",
        BatchSaveStatus.Failed => "Thất bại",
        BatchSaveStatus.Unknown => "Chưa xác định",
        BatchSaveStatus.Saving => "Đang lưu",
        _ => "Chưa lưu"
    };
    private static bool CanRetry(ResolvedMenuRow row) => row.LastSaveOutcome is
        not SaveBatchOutcome.Unauthorized and not SaveBatchOutcome.Forbidden and
        not SaveBatchOutcome.LicenseBlocked and not SaveBatchOutcome.Unknown and
        not SaveBatchOutcome.Cancelled;

    public void Dispose()
    {
        _saveCts?.Cancel();
        _saveCts?.Dispose();
        _lifetimeCts.Cancel();
        _lifetimeCts.Dispose();
    }

    private enum RowFilter { All, Valid, RequiresSelection, Error, Saved, SaveFailed }
    private enum SaveRequestKind { Bulk, RetryFailed, Single }
}
