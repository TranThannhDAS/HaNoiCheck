@inject IApplicationControlService ApplicationControl

<section class="license-page">
    <div class="license-card expired">
        <div class="license-icon">!</div>
        <p class="eyebrow accent">HANOICHECK DEMO</p>
        <h1>Phiên bản dùng thử đã hết hạn</h1>
        <p>Thời hạn sử dụng: <strong>@Status.ExpirationDate.ToString("dd/MM/yyyy")</strong></p>
        <p>Vui lòng liên hệ nhà cung cấp để tiếp tục sử dụng.</p>
        <button class="primary-button" type="button" @onclick="ApplicationControl.CloseApplication">
            Đóng ứng dụng
        </button>
    </div>
</section>

@code {
    [Parameter, EditorRequired]
    public DemoLicenseStatus Status { get; set; } = default!;
}
